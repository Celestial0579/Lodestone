    "fake-indexeddb": "^6.2.8",
    "front-matter": "^4.0.2",
    "glob": "^7.1.2",
    "global-jsdom": "^26.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^26.1.0",
    "legal-eagle": "0.16.0",
    "mini-css-extract-plugin": "^2.10.2",
