    "@types/memoize-one": "^3.1.2",
    "@types/minimist": "^1.2.5",
    "@types/mri": "^1.2.0",
    "@types/node": "22.10.9",
    "@types/parse-dds": "^1.0.3",
    "@types/plist": "^3.0.5",
